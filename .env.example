# ======================================================================
# KONFIGURASI SERVER & PORT
# ======================================================================
PORT=30493

# ======================================================================
# IDENTITAS OWNER & BOT WHATSAPP
# Format nomor telepon menggunakan kode negara tanpa tanda '+' (contoh: 628123456789)
# ======================================================================
OWNER_NUMBER=628xxxxxxxxxx
OWNER_LID=
BOT_NUMBER=628xxxxxxxxxx
BOT_NAME=SuperWayan

# ======================================================================
# PENYEDIA LAYANAN AI (gemini / openai / claude)
# ======================================================================
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_ai_api_key_here

# ======================================================================
# FITUR & BATASAN PENGAMAN (SAFETY GUARDS)
# ======================================================================
ENABLE_SEND_DM=false
ENABLE_ADD_MEMBER=false
MAX_DESTRUCTIVE_ACTIONS_PER_RUN=10

# ======================================================================
# KONFIGURASI AUTONOMOUS LOOP
# Sesuaikan untuk mengontrol perilaku proses iteratif (loop) AI
# ======================================================================
# Jumlah fase luar maksimum (default: 5)
LOOP_MAX_OUTER_STEPS=5
# Jumlah langkah dalam per fase (default: 5)
LOOP_MAX_INNER_STEPS=5
# Timeout per langkah AI dalam milidetik (default: 60000 = 1 menit)
LOOP_STEP_TIMEOUT_MS=60000
# Base delay untuk exponential backoff saat retry dalam milidetik (default: 2000)
LOOP_BASE_RETRY_DELAY_MS=2000
# Jumlah maksimum entri log yang dikirim ke AI (default: 20, sisanya diringkas)
LOOP_MAX_LOG_ENTRIES=20

# ======================================================================
# SESI & KONEKSI
# ======================================================================
SESSION_PATH=./auth_info